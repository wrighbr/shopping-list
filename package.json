{
  "name": "shopping-list",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace web dev",
    "build": "yarn workspace web build && yarn workspace login-consent-app build",
    "lint": "biome check apps/web/src apps/login-consent-app/src",
    "lint:fix": "biome check --write apps/web/src apps/login-consent-app/src",
    "format": "biome format --write apps/web/src apps/login-consent-app/src",
    "test": "yarn workspace login-consent-app test && yarn workspace web test",
    "stack:up": "docker compose up -d --build && ./auth/register-clients.sh",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
