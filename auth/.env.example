# Copy this file to .env in the same directory and fill in real values.
# .env is gitignored - never commit real secrets.

# Postgres password for the Hydra database.
POSTGRES_PASSWORD=change-me

# Hydra system secret used to encrypt cookies/sessions - must be at least 32 characters.
SECRETS_SYSTEM=change-me-to-a-random-32-char-or-longer-string

# Dev-only test user credentials for the login/consent app.
# This is a hardcoded stand-in for a real identity provider - do not use in production.
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password
